let currentKingdom = 'all';
let searchQuery = '';

function renderGallery() {
  const container = document.getElementById('gallery');
  const filtered = SPECIMENS.filter(s => {
    const kMatch = currentKingdom === 'all' || s.kingdom === currentKingdom;
    const sMatch = (s.genus + s.species + s.locality + s.group).toLowerCase().includes(searchQuery.toLowerCase());
    return kMatch && sMatch;
  });

  container.innerHTML = filtered.map((s, idx) => `
    <div class="card" onclick="openModal(${SPECIMENS.indexOf(s)})">
      <div class="card-img">
        ${s.images.length ? `<img src="images/${s.images[0]}" alt="${s.genus}">` : `<div style="padding:4rem;text-align:center;opacity:0.3">Pas de photo</div>`}
      </div>
      <div class="card-body">
        <span class="card-id">${s.id}</span>
        <h3 class="card-title">${s.genus} <em>${s.species}</em></h3>
        <div style="font-size:0.8rem; color:#666; margin-top:0.5rem;">${s.group} • ${s.stage}</div>
      </div>
    </div>
  `).join('');
}

function filterKingdom(k) {
  currentKingdom = k;
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  event.target.classList.add('active');
  renderGallery();
}

document.getElementById('search').addEventListener('input', (e) => {
  searchQuery = e.target.value;
  renderGallery();
});

function openModal(idx) {
  const s = SPECIMENS[idx];
  const modal = document.getElementById('modal-backdrop');
  modal.innerHTML = `
    <div class="modal">
      <button class="modal-close" onclick="closeModal()">×</button>
      <div class="modal-img-side">
        ${s.images.length ? `<img src="images/${s.images[0]}" alt="${s.genus}">` : ''}
      </div>
      <div class="modal-info">
        <span class="card-id">${s.id}</span>
        <h2 class="card-title" style="font-size:2rem">${s.genus} <em>${s.species}</em></h2>
        <p><strong>Groupe :</strong> ${s.group}</p>
        <p><strong>Étage :</strong> ${s.stage}</p>
        <p><strong>Lieu :</strong> ${s.locality}</p>
        <p><strong>Taille :</strong> ${s.size}</p>
        <p><strong>Date :</strong> ${s.date}</p>
        <hr style="opacity:0.1; margin:2rem 0">
        <p style="font-style:italic; color:#555">${s.notes || 'Pas de notes.'}</p>
      </div>
    </div>
  `;
  modal.style.display = 'flex';
}

function closeModal() { document.getElementById('modal-backdrop').style.display = 'none'; }

// Initialisation
renderGallery();
</script>

