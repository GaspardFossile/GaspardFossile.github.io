<style>
  :root {
    --wood: #131110;
    --paper: #f4eee0;
    --brass: #b08d57;
    --rust: #92400e;
    --transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
  }

  * { box-sizing: border-box; }
  body {
    margin: 0; background: var(--wood); color: var(--paper);
    font-family: 'Inter', sans-serif;
    background-image: linear-gradient(to bottom, rgba(19, 17, 16, 0.8), rgba(19, 17, 16, 0.95)), 
                      url("https://www.transparenttextures.com/patterns/stardust.png");
  }

  header { padding: 8rem 2rem 4rem; text-align: center; border-bottom: 1px solid rgba(176,141,87,0.2); }
  .eyebrow { font-family: 'IBM Plex Mono'; font-size: 0.7rem; letter-spacing: 0.5em; color: var(--brass); text-transform: uppercase; }
  h1 { font-family: 'Fraunces'; font-size: clamp(2.5rem, 8vw, 4rem); margin: 1rem 0; }
  h1 em { color: var(--brass); font-style: italic; font-weight: 400; }

  .sticky-nav { position: sticky; top: 0; z-index: 100; background: rgba(19,17,16,0.9); backdrop-filter: blur(10px); padding: 1rem; border-bottom: 1px solid rgba(176,141,87,0.1); }
  .nav-content { max-width: 1200px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; }
  
  .tabs { display: flex; gap: 0.5rem; }
  .tab { 
    background: none; border: 1px solid transparent; color: rgba(255,255,255,0.4); 
    padding: 0.5rem 1rem; cursor: pointer; font-family: 'IBM Plex Mono'; font-size: 0.7rem; border-radius: 20px;
  }
  .tab.active { color: var(--brass); border-color: var(--brass); background: rgba(176,141,87,0.1); }

  .search { background: rgba(0,0,0,0.3); border: 1px solid rgba(176,141,87,0.2); color: white; padding: 0.6rem 1.5rem; border-radius: 20px; min-width: 250px; font-family: 'IBM Plex Mono'; }

  .gallery { max-width: 1200px; margin: 3rem auto; padding: 0 2rem; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 2rem; }

  .card { 
    background: var(--paper); color: #1c1917; border-radius: 2px; overflow: hidden; cursor: pointer;
    transition: var(--transition); box-shadow: 0 10px 30px rgba(0,0,0,0.3);
  }
  .card:hover { transform: translateY(-10px); box-shadow: 0 20px 40px rgba(0,0,0,0.5); }
  .card-img { width: 100%; aspect-ratio: 4/3; background: #ddd; overflow: hidden; }
  .card-img img { width: 100%; height: 100%; object-fit: cover; transition: 0.6s; }
  .card:hover .card-img img { transform: scale(1.1); }
  .card-body { padding: 1.2rem; }
  .card-id { font-family: 'IBM Plex Mono'; font-size: 0.6rem; color: var(--rust); font-weight: bold; }
  .card-title { font-family: 'Fraunces'; font-size: 1.2rem; margin: 0.3rem 0; }
  .card-title em { font-weight: 400; }

  .modal-backdrop { 
    display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.9); 
    z-index: 1000; padding: 2rem; align-items: center; justify-content: center; backdrop-filter: blur(5px);
  }
  .modal { 
    background: var(--paper); color: #1c1917; width: 100%; max-width: 1000px; 
    display: grid; grid-template-columns: 1fr 1fr; border-radius: 4px; overflow: hidden; position: relative;
  }
  .modal-close { position: absolute; top: 1rem; right: 1rem; font-size: 2rem; border: none; background: none; cursor: pointer; z-index: 10; }
  .modal-img-side { background: #000; display: flex; align-items: center; justify-content: center; position: relative; }
  .modal-img-side img { max-width: 100%; max-height: 80vh; object-fit: contain; }
  .modal-info { padding: 3rem; overflow-y: auto; max-height: 80vh; }

  @media (max-width: 800px) { .modal { grid-template-columns: 1fr; } .modal-img-side { height: 40vh; } }
</style>
</head>
